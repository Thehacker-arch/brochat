# Copy to keystore.properties (same folder) and fill in real values.
# Do not commit keystore.properties or your .jks file.
#
# password = keystore password (and key password if you used the same in keytool)
# keyAlias = alias you chose with keytool (-alias)
# storeFile = absolute path to your .jks file

password=CHANGE_ME
keyAlias=brochat
storeFile=/absolute/path/to/brochat-upload.jks
